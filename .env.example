# ─────────────────────────────────────────────────────
#  .env.example — Safe to commit to git
#  Copy this to .env and fill in real values for local dev
#
#  On Railway, set these in the "Variables" tab instead.
#  The MySQL plugin auto-injects MYSQL* variables.
# ─────────────────────────────────────────────────────

# ── Local Database (XAMPP / local dev) ──────────────
# On Railway these are auto-injected by the MySQL plugin
# as MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lexio

# ── Gemini AI API Key ────────────────────────────────
# Get yours free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── App Environment ──────────────────────────────────
# Set to "production" on Railway for secure cookies & error suppression
APP_ENV=local

# ── Database Setup Token (one-time use) ─────────────
# Set a random secret here, visit /setup_db.php?token=<this_value>
# then REMOVE this variable. Leave blank locally (setup_db runs freely).
# SETUP_TOKEN=change_me_to_something_random
